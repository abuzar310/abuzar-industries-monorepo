{
  "name": "abuzar-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/unofficial -p 3010",
    "dev:unofficial": "next dev apps/unofficial -p 3010",
    "dev:official": "next dev apps/official -p 3020",
    "build:unofficial": "next build apps/unofficial",
    "build:official": "next build apps/official",
    "start:unofficial": "next start apps/unofficial -p 3010",
    "start:official": "next start apps/official -p 3020",
    "lint": "eslint apps packages",
    "typecheck": "tsc --noEmit",
    "check": "tsx packages/core/src/lib/calc.check.ts && tsx packages/core/src/lib/ledger.check.ts && tsx packages/core/src/lib/trading.check.ts && tsx packages/core/src/lib/payments.check.ts && tsx packages/core/src/lib/accounts.check.ts && tsx packages/core/src/lib/expenses.check.ts && tsx packages/core/src/lib/invoice-id.check.ts && tsx packages/core/src/lib/numbering.check.ts"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-rnd": "^10.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
