# Postgres connection string — the single source of truth for all app data.
# Server-side only (never shipped to the browser). Real values live in .env.local
# (gitignored). Copy this file to .env.local and fill it in.
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project.supabase.co:5432/postgres

# Signs the httpOnly session cookie. Generate one: openssl rand -hex 32
APP_SESSION_SECRET=

# Master password that unlocks any user (staff convenience, server-side only).
APP_MASTER_PASSWORD=

# GSTIN lookup (invoice "Verify" button → fetches the registered business name + status).
# Server-side only. Get a free key_secret from https://appyflow.in/verify-gst
# (50 free lookups). Without this, Verify shows a "not configured" message.
GST_API_KEY=
# Provider is "appyflow" by default; leave unset unless you wire another one.
GST_API_PROVIDER=appyflow

# AI assistant (/ai tab + floating button). Server-side only — never NEXT_PUBLIC_*.
# Google AI Studio Gemini key: https://aistudio.google.com/apikey
AI_API_KEY=
AI_MODEL=gemini-flash-latest
