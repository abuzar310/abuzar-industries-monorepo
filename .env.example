# Supabase project the app syncs to.
# The publishable key is browser-safe (anon-equivalent) — it is meant to ship to the client.
# Real values live in .env.local (gitignored). Copy this file to .env.local and fill them in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Comma-separated emails allowed into the Settings tab (Supabase email-auth path; optional).
NEXT_PUBLIC_ADMIN_EMAILS=you@business.com

# Shared app-lock password for the local user picker (Afsar / Ajju). Staff lock, not a hard secret.
NEXT_PUBLIC_APP_PASSWORD=kingking

# GSTIN lookup (invoice "Verify" button → fetches the registered business name + status).
# Server-side only (never shipped to the browser). Get a free key_secret from
# https://appyflow.in/verify-gst (50 free lookups). Without this, Verify shows a
# "not configured" message but the app works normally.
GST_API_KEY=
# Provider is "appyflow" by default; leave unset unless you wire another one.
GST_API_PROVIDER=appyflow
